PORT=3001
BACKEND_URL=http://localhost:3000
GATEWAY_ID=local-gateway-1

# Modo de codificador de video: auto | hw | sw
# auto: detecta h264_v4l2m2m en runtime; si no está disponible, usa libx264
# hw: fuerza el uso de h264_v4l2m2m
# sw: fuerza el uso de libx264 (software)
VIDEO_ENCODER_MODE=auto

# Ejemplo de URLs RTSP locales. Reemplaza con las credenciales e IPs reales de tus cámaras.
RTSP_CAMARA_PATIO=rtsp://username:password@IP_ADDRESS:PORT/stream_path
RTSP_CAMARA_ENTRADA=rtsp://username:password@IP_ADDRESS:PORT/stream_path
